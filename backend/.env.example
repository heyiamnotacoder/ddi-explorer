# --- LLM (reasoning) ---
# litellm model string — provider-agnostic, swap freely.
# Examples: anthropic/claude-sonnet-5 | deepseek/deepseek-v4-flash | openai/gpt-4o
LLM_MODEL=anthropic/claude-sonnet-5

# Fill in the key for whichever provider(s) you use:
ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# --- Vision (OCR fallback ONLY) ---
# Claude has vision — same provider/key works. DeepSeek is text-only,
# so with DeepSeek you'd point this at a vision-capable model.
VISION_MODEL=anthropic/claude-sonnet-5
# GEMINI_API_KEY=...

# --- Web search/fetch for Grade C evidence (Firecrawl) ---
FIRECRAWL_API_KEY=fc-...

# --- OCR ---
OCR_CONFIDENCE_THRESHOLD=0.75

# --- Optional: openFDA API key (works without, rate-limited) ---
OPENFDA_API_KEY=

# --- Pipeline limits (defaults shown; all optional) ---
MAX_DRUGS_PER_REQUEST=15
PAIR_CONCURRENCY=5
HTTP_TIMEOUT=30

# --- Production ---
# Comma-separated exact origins. Local Vite is the default.
CORS_ORIGINS=http://localhost:5173
# Vercel preview + production hosts. Empty to disable the regex.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Presidio NER. Use en_core_web_sm on Render (lg will OOM on starter RAM).
SPACY_MODEL=en_core_web_lg
